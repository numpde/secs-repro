schema_id = "secs.provider.config.v1"

[api]
origin = "https://api.example.test"
topology = "web"
connect_timeout_seconds = 5
io_deadline_seconds = 30

[hello]
display_name = "SECS"
provider_description = "Ranks and refines molecular-structure candidates from a molecular formula and one processed one-dimensional proton NMR spectrum. Guide, license, attribution, and source details: https://numpde.github.io/secs-repro/"
publication_interval_seconds = 3600
retry_initial_seconds = 5

# Omit this table to publish hello without accepting Jobs.
[execution]
interpreter_url = "https://model.example.test/v1/chat/completions"
interpreter_model = "replace-with-deployment-model"
# gpt-5.6-luna requires none for function tools on Chat Completions.
# Other endpoints may use a different effort, or omit it for their default.
interpreter_reasoning_effort = "none"
upload_store_origin = "https://uploads.example.test"
work_seconds = 1800
interpretation_seconds = 120
worker_startup_seconds = 600
poll_seconds = 5
max_turns = 12
max_upload_bytes = 134217728
max_total_bytes = 268435456
