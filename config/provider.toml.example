schema_id = "secs.provider.config.v5"

# Set these nonsecret values to the shared project and its socket group.
[shared]
project = "replace-me"
gid = 1

[api]
origin = "https://api.example.test"
profile = "dev-local"
topology = "dev-local"
provider_ref = "provider:replace-me"
credential_file = "/run/secrets/provider/provider.signing.private.json"
exchange_seconds = 30
retirement_seconds = 10
# ca_file = "/run/config/provider/api-ca.crt"

[delivery]
exchange_seconds = 30
retry_initial_seconds = 1
retry_max_seconds = 30

[hello]
display_name = "SECS"
provider_description = "Ranks and refines molecular-structure candidates from a molecular formula and one processed one-dimensional proton NMR spectrum. Guide, license, attribution, and source details: https://numpde.github.io/secs-repro/"
publication_interval_seconds = 3600
retry_initial_seconds = 5

# Omit both [execution] and [interpreter] to publish hello without accepting Jobs.
[execution]
# Configure ordered model endpoints in interpreter.d.
upload_store_origin = "https://uploads.example.test"
work_seconds = 1800
worker_startup_seconds = 600
poll_seconds = 5
max_upload_bytes = 134217728
max_total_bytes = 268435456

[interpreter]
timeout_seconds = 120
