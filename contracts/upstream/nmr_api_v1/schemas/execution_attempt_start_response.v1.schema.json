{"$id":"nmr.provider.execution_attempt_start_response.v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"analysis_kind_ref":{"maxLength":128,"minLength":1,"pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?![\\s\\S])","type":"string"},"execution_attempt_ref":{"description":"Server-issued attempt identity. Journal it before beginning work.","pattern":"^execution_attempt:sha256:[0-9a-f]{64}(?![\\s\\S])","type":"string"},"job_ref":{"maxLength":128,"minLength":5,"pattern":"^job:[A-Za-z0-9_.-]{1,124}(?![\\s\\S])","type":"string"},"provider_ref":{"maxLength":128,"minLength":10,"pattern":"^provider:[A-Za-z0-9_.-]{1,119}(?![\\s\\S])","type":"string"},"replayed":{"description":"True when the same provider attempt key and start facts replayed an existing attempt.","type":"boolean"},"schema_id":{"const":"nmr.provider.execution_attempt_start_response.v1"},"started_at":{"format":"date-time","pattern":"^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.(?!000000)[0-9]{6})?Z(?![\\s\\S])","type":"string"},"state":{"enum":["in_progress","succeeded","failed","expired"]}},"required":["schema_id","execution_attempt_ref","job_ref","analysis_kind_ref","provider_ref","state","started_at","replayed"],"type":"object"}
