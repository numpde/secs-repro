{"$id":"nmr.provider.job_input.read.response.v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"canonical_input_base64":{"contentEncoding":"base64","description":"Base64 of the exact UTF-8 Job specification text. Decode the bytes without normalization and interpret them according to input_schema_id.","maxLength":87384,"minLength":1,"pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?(?![\\s\\S])","type":"string"},"input_byte_length":{"maximum":65536,"minimum":1,"type":"integer"},"input_fingerprint":{"maxLength":71,"minLength":71,"pattern":"^sha256:[0-9a-f]{64}(?![\\s\\S])","type":"string"},"input_schema_id":{"const":"nmr.job.specification.text.v1"},"job_ref":{"maxLength":128,"minLength":5,"pattern":"^job:[A-Za-z0-9_.-]{1,124}(?![\\s\\S])","type":"string"},"schema_id":{"const":"nmr.provider.job_input.read.response.v1"}},"required":["schema_id","job_ref","input_fingerprint","input_schema_id","input_byte_length","canonical_input_base64"],"type":"object"}
